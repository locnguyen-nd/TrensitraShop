# Spring Application Configuration
SPRING_APPLICATION_NAME=TrendistaShop
SERVER_PORT=8080
API_PREFIX=/api/v1

# Frontend URLs
FRONTEND_DEV_URL=http://localhost:3000
FRONTEND_PROD_URL=http://localhost:4000
ADMIN_DEV_URL=http://localhost:5173
ADMIN_PROD_URL=http://localhost:5183

# Database Configuration
DB_HOST=mysql
DB_PORT=3306
DB_NAME=trendista
DB_USERNAME=root
DB_PASSWORD=your_db_password

# Railway Database (if using Railway hosting)
RAILWAY_DB_PASSWORD=your_railway_db_password

# JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_base64_encoded
JWT_EXPIRES_IN=86400
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
JWT_VERIFICATION_EXPIRES_IN=86400

# Email Configuration (SMTP Gmail)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_specific_password
BACKUP_EMAIL=backup_email@gmail.com

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# VietQR Configuration
VIETQR_CLIENT_ID=your_vietqr_client_id
VIETQR_API_KEY=your_vietqr_api_key
VIETQR_ACCOUNT_NO=your_account_number
VIETQR_ACCOUNT_NAME=YOUR_ACCOUNT_NAME
VIETQR_BANK_ID=your_bank_id

# PayOS Configuration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key
PAYOS_RETURN_URL=http://localhost:8080/api/v1/order/payment/success
PAYOS_CANCEL_URL=http://localhost:8080/api/v1/payment/cancel

# Verification Settings
VERIFICATION_MAX_ATTEMPTS=5
SEARCH_SUGGESTION_LIMIT=5