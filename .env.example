# Spring Application Configuration
SPRING_APPLICATION_NAME=TrendistaShop
SERVER_PORT=8080
API_PREFIX=/api/v1

# Frontend URLs
FRONTEND_DEV_URL=http://localhost:3000
FRONTEND_PROD_URL=http://localhost:4000
ADMIN_DEV_URL=http://localhost:5173
ADMIN_PROD_URL=http://localhost:5183

# Database Configuration
DB_HOST=mysql # Use 'mysql' for Docker, 'localhost' for local
DB_PORT=3306
DB_NAME=trendista
DB_USERNAME=root
DB_PASSWORD=

# Railway Database (if using Railway hosting)
RAILWAY_DB_PASSWORD=

# JWT Configuration
JWT_SECRET_KEY=
JWT_EXPIRES_IN=86400
JWT_REFRESH_TOKEN_EXPIRES_IN=604800
JWT_VERIFICATION_EXPIRES_IN=86400

# Email Configuration (SMTP Gmail)
MAIL_USERNAME=email@gmail.com
MAIL_PASSWORD=
BACKUP_EMAIL=backup_email@gmail.com

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret

# VietQR Configuration
VIETQR_CLIENT_ID=vietqr_client_id
VIETQR_API_KEY=vietqr_api_key
VIETQR_ACCOUNT_NO=account_number
VIETQR_ACCOUNT_NAME=account_name
VIETQR_BANK_ID=bank_id

# PayOS Configuration
PAYOS_CLIENT_ID=payos_client_id
PAYOS_API_KEY=payos_api_key
PAYOS_CHECKSUM_KEY=payos_checksum_key
PAYOS_RETURN_URL=http://localhost:8080/api/v1/order/payment/success
PAYOS_CANCEL_URL=http://localhost:8080/api/v1/payment/cancel

# Verification Settings
VERIFICATION_MAX_ATTEMPTS=5
SEARCH_SUGGESTION_LIMIT=5