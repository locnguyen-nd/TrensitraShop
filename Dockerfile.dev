# Dev image runs mvn spring-boot:run with DevTools
FROM maven:3.9-eclipse-temurin-21
WORKDIR /app

# Pre-warm maven cache with pom only
COPY pom.xml ./
RUN --mount=type=cache,target=/root/.m2 \
    mvn -q -DskipTests dependency:go-offline

# Copy source last (we’ll still bind-mount in compose)
COPY src ./src

ENV SPRING_PROFILES_ACTIVE=dev \
    SPRING_DEVTOOLS_RESTART_ENABLED=true \
    SPRING_DEVTOOLS_LIVERELOAD_ENABLED=true

EXPOSE 8080 35729
# Healthcheck via actuator
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD curl -fsS http://localhost:8080/actuator/health >/dev/null || exit 1

# Default command for dev
CMD ["sh","-c","mvn -q -Dspring-boot.run.jvmArguments='-XX:MaxRAMPercentage=75' spring-boot:run"]
